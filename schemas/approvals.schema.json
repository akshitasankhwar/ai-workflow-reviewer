{
  "$defs": {
    "AddRequirement": {
      "additionalProperties": false,
      "properties": {
        "after": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Insert after this requirement id; None = first.",
          "title": "After"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "AddRequirement",
      "type": "object"
    },
    "Approval": {
      "additionalProperties": true,
      "description": "Only the top-level metadata is trusted; free-text fields are never interpreted.",
      "properties": {
        "applies_to_revision": {
          "title": "Applies To Revision",
          "type": "string"
        },
        "approver": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Approver"
        },
        "changes": {
          "items": {
            "$ref": "#/$defs/Change"
          },
          "title": "Changes",
          "type": "array"
        },
        "decided_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decided At"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "sequence": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sequence"
        },
        "status": {
          "enum": [
            "approved",
            "pending",
            "rejected",
            "withdrawn"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "id",
        "status",
        "applies_to_revision",
        "changes"
      ],
      "title": "Approval",
      "type": "object"
    },
    "Change": {
      "additionalProperties": false,
      "properties": {
        "add": {
          "anyOf": [
            {
              "$ref": "#/$defs/AddRequirement"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "remove": {
          "default": false,
          "title": "Remove",
          "type": "boolean"
        },
        "requirement": {
          "title": "Requirement",
          "type": "string"
        },
        "set_route": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Set Route"
        },
        "set_threshold": {
          "anyOf": [
            {
              "$ref": "#/$defs/ThresholdChange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "requirement"
      ],
      "title": "Change",
      "type": "object"
    },
    "ThresholdChange": {
      "additionalProperties": false,
      "properties": {
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value"
      ],
      "title": "ThresholdChange",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "approvals": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Approval"
      },
      "title": "Approvals",
      "type": "array"
    }
  },
  "title": "ApprovalsFile",
  "type": "object"
}
